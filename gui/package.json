{
  "name": "agent-studio-gui",
  "version": "0.1.4",
  "private": true,
  "description": "Agent Studio desktop front end (Hydra renderer, adapted)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
